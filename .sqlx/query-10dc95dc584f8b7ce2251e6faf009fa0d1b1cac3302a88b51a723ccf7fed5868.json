  "query": "SELECT CASE WHEN closure.descendant = ?1 THEN ?2 ELSE ?3 END AS \"kin!: String\", nodes.id, nodes.project, nodes.facet, nodes.stage, nodes.provenance FROM closure JOIN nodes ON nodes.id = CASE WHEN closure.descendant = ?1 THEN closure.ancestor ELSE closure.descendant END WHERE (closure.descendant = ?1 AND closure.depth > 0) OR (closure.ancestor = ?1 AND closure.depth = 1) ORDER BY CASE WHEN closure.descendant = ?1 THEN -closure.depth ELSE nodes.id END, nodes.id",
