  "query": "\nSELECT\n  ideals.id AS ideal,\n  ideals.superseded_by,\n  ideal_quotes.message,\n  messages.at,\n  ideal_quotes.excerpt\nFROM\n  ideals\n  JOIN ideal_quotes ON ideal_quotes.ideal = ideals.id\n  JOIN messages ON messages.uuid = ideal_quotes.message\nORDER BY\n  ideals.id,\n  ideal_quotes.place\n",
