  "query": "\nSELECT\n  messages.uuid,\n  messages.author,\n  segments.ordinal\nFROM\n  messages\n  JOIN segments ON segments.message = messages.uuid\nWHERE\n  substr(messages.uuid, 1, length(?1)) = ?1\nORDER BY\n  messages.uuid,\n  segments.ordinal\n",
