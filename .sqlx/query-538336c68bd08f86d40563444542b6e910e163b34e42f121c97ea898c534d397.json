  "query": "\nSELECT\n  message,\n  ordinal,\n  kind,\n  specificity,\n  confidence,\n  explicitness,\n  provenance,\n  CASE\n    WHEN EXISTS (\n      SELECT\n        1\n      FROM\n        senses AS later\n      WHERE\n        later.supersedes = senses.id\n    ) THEN ?2\n    ELSE ?3\n  END AS \"standing!: String\"\nFROM\n  senses\nWHERE\n  message = ?1\nORDER BY\n  ordinal,\n  id\n",
