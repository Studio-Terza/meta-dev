{
  "db_name": "SQLite",
  "query": "\nSELECT\n  CASE\n    WHEN closure.descendant = ?1 THEN ?2\n    ELSE ?3\n  END AS \"kin!: String\",\n  nodes.id,\n  nodes.project,\n  nodes.facet,\n  nodes.stage,\n  nodes.provenance,\n  nodes.title,\n  nodes.role,\n  nodes.role_provenance,\n  nodes.artifact,\n  nodes.condition,\n  nodes.reason\nFROM\n  closure\n  JOIN nodes ON nodes.id = CASE\n    WHEN closure.descendant = ?1 THEN closure.ancestor\n    ELSE closure.descendant\n  END\nWHERE\n  closure.relation = ?4\n  AND (\n    (\n      closure.descendant = ?1\n      AND closure.depth > 0\n    )\n    OR (\n      closure.ancestor = ?1\n      AND closure.depth = 1\n    )\n  )\nORDER BY\n  CASE\n    WHEN closure.descendant = ?1 THEN - closure.depth\n    ELSE nodes.id\n  END,\n  nodes.id\n",
