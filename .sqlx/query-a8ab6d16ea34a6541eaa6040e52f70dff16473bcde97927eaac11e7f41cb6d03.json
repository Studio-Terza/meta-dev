{
  "db_name": "SQLite",
  "query": "\nSELECT\n  id,\n  project,\n  facet,\n  stage,\n  provenance,\n  title,\n  role,\n  role_provenance,\n  artifact,\n  condition,\n  reason\nFROM\n  nodes\nWHERE\n  (\n    stage IN (?1, ?2)\n    OR (\n      facet = ?3\n      AND stage != ?4\n    )\n  )\n  AND NOT EXISTS (\n    SELECT\n      1\n    FROM\n      closure\n      JOIN nodes AS above ON above.id = closure.ancestor\n    WHERE\n      closure.relation = ?5\n      AND closure.descendant = nodes.id\n      AND above.stage = ?4\n  )\nORDER BY\n  project,\n  id\n",
