{
  "db_name": "SQLite",
  "query": "\nSELECT\n  nodes.id,\n  nodes.project,\n  nodes.facet,\n  nodes.stage,\n  nodes.title,\n  (\n    SELECT\n      MIN(closure.ancestor)\n    FROM\n      closure\n    WHERE\n      closure.relation = ?2\n      AND closure.descendant = nodes.id\n      AND closure.depth = 1\n  ) AS \"parent?: i64\"\nFROM\n  nodes\nWHERE\n  nodes.stage != ?1\n  AND NOT EXISTS (\n    SELECT\n      1\n    FROM\n      closure\n      JOIN nodes AS above ON above.id = closure.ancestor\n    WHERE\n      closure.relation = ?2\n      AND closure.descendant = nodes.id\n      AND above.stage = ?1\n  )\nORDER BY\n  nodes.project,\n  nodes.id\n",
