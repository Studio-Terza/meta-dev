  "query": "\nSELECT\n  id,\n  project,\n  facet,\n  stage,\n  provenance,\n  title,\n  role,\n  role_provenance,\n  artifact,\n  condition,\n  reason\nFROM\n  (\n    SELECT\n      id,\n      project,\n      facet,\n      stage,\n      provenance,\n      title,\n      role,\n      role_provenance,\n      artifact,\n      condition,\n      reason\n    FROM\n      nodes\n    WHERE\n      project = ?1\n      AND stage != ?2\n    ORDER BY\n      id DESC\n    LIMIT\n      200\n  )\nORDER BY\n  id\n",
