  "query": "\nSELECT\n  features.name,\n  features.consideration,\n  feature_quotes.message,\n  messages.at,\n  feature_quotes.excerpt\nFROM\n  features\n  JOIN feature_quotes ON feature_quotes.feature = features.name\n  JOIN messages ON messages.uuid = feature_quotes.message\nORDER BY\n  features.place,\n  feature_quotes.place\n",
