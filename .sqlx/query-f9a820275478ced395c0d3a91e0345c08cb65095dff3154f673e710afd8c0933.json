  "db_name": "SQLite",
  "query": "\nSELECT\n  segments.rowid AS \"id!: i64\",\n  messages.uuid,\n  messages.author,\n  messages.at,\n  segments.body,\n  segments_fts.rank AS \"rank!: f64\"\nFROM\n  segments_fts\n  JOIN segments ON segments.rowid = segments_fts.rowid\n  JOIN messages ON messages.uuid = segments.message\nWHERE\n  segments_fts MATCH ?1\n  AND (\n    ?2 IS NULL\n    OR messages.author = ?2\n  )\n",
