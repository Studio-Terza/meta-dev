{
  "db_name": "SQLite",
  "query": "\nSELECT\n  nodes.id,\n  nodes.project,\n  nodes.facet,\n  nodes.stage,\n  nodes.title,\n  (\n    SELECT\n      MIN(closure.ancestor)\n    FROM\n      closure\n    WHERE\n      closure.relation = ?1\n      AND closure.descendant = nodes.id\n      AND closure.depth = 1\n  ) AS \"parent?: i64\"\nFROM\n  nodes\n  JOIN live_nodes ON live_nodes.id = nodes.id\nORDER BY\n  nodes.project,\n  nodes.id\n",
