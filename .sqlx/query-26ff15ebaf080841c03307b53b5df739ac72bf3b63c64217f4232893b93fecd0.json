{
  "db_name": "SQLite",
  "query": "\nSELECT\n  span_edges.node,\n  span_edges.relation,\n  span_edges.message,\n  span_edges.ordinal,\n  messages.author,\n  segments.body,\n  span_edges.provenance,\n  senses.kind,\n  senses.specificity,\n  senses.confidence,\n  senses.explicitness\nFROM\n  span_edges\n  JOIN segments ON segments.message = span_edges.message\n  AND segments.ordinal = span_edges.ordinal\n  JOIN messages ON messages.uuid = span_edges.message\n  LEFT JOIN senses ON senses.message = span_edges.message\n  AND senses.ordinal = span_edges.ordinal\n  AND NOT EXISTS (\n    SELECT\n      1\n    FROM\n      senses AS later\n    WHERE\n      later.supersedes = senses.id\n  )\nWHERE\n  span_edges.node = ?1\nORDER BY\n  span_edges.rowid\n",
